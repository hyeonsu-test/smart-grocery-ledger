@startuml
!pragma layout smetana
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #41686A
skinparam classHeaderBackgroundColor #E7F1EF
skinparam ArrowColor #41686A
hide empty members
top to bottom direction
class LedgerFrame {
  ~ loadedMonth : String
  ~ navigate(index : int)
  ~ refreshAfterPriceChange()
}
abstract class TabView {
  ~ frame : LedgerFrame
  ~ hasDraft() : boolean
  ~ discardDraft()
}
class LedgerTab {
  - ledger : LedgerService
}
class BudgetTab {
  - budget : BudgetService
}
class ProductTab {
  - products : ProductService
}
class PriceTab {
  - prices : PriceService
}
class TargetTab {
  - targets : TargetService
}
LedgerFrame "1" *-- "5" TabView : owns screens
TabView <|-- LedgerTab
TabView <|-- BudgetTab
TabView <|-- ProductTab
TabView <|-- PriceTab
TabView <|-- TargetTab
@enduml
