@startuml
!pragma layout smetana
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #41686A
skinparam classHeaderBackgroundColor #E7F1EF
skinparam ArrowColor #41686A
hide empty members
top to bottom direction
class LedgerFrame {
  ~ loadedMonth : String
  ~ navigate(index : int)
  ~ refreshAfterPriceChange()
  + dispose()
}
abstract class TabView {
  ~ frame : LedgerFrame
  ~ hasDraft() : boolean
  ~ discardDraft()
}
class LedgerTab {
  - ledger : LedgerService
  - purchaseId : String
  - updateEntryFields()
}
class BudgetTab {
  - budget : BudgetService
  - planItemId : String
}
class ProductTab {
  - products : ProductService
  - online : OnlineCollectionService
  - worker : SwingWorker
  - closed : boolean
  ~ collectOnline(auto : boolean)
  ~ close()
}
class PriceTab {
  - prices : PriceService
  - historyProductId : String
  - clearHistory()
}
class TargetTab {
  - targets : TargetService
  - editingTargetId : String
  - targetDirty : boolean
  - addFavorite()
}
LedgerFrame "1" *-- "5" TabView : owns screens
TabView <|-- LedgerTab
TabView <|-- BudgetTab
TabView <|-- ProductTab
TabView <|-- PriceTab
TabView <|-- TargetTab
@enduml
