@startuml
!pragma layout smetana
skinparam dpi 180
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 15
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #405862
skinparam classHeaderBackgroundColor #EAF0F2
skinparam ArrowColor #405862
skinparam nodesep 35
skinparam ranksep 45
left to right direction
abstract class Service {
  ~ repo : Repository
  ~ clock : Clock
  ~ now() : OffsetDateTime
  ~ call() : Map
}
class LedgerService {
  + manageLedger() : Map
}
class BudgetService {
  + manageBudgetPlan() : Map
}
class PriceService {
  + analyzePrices() : Map
  {static} + normalizeUnitPrice() : BigDecimal
}
class ProductService {
  - adapter : MartAdapter
  - targets : TargetService
  + manageProducts() : Map
}
class TargetService {
  + managePurchaseTargets() : Map
  + basis() : Map
}
class MartAdapter {
  + fetchOffers() : Map
}
class OnlineCollectionService {
  - collector : ProductCollector
  - targets : TargetService
  - closed : boolean
  + collect() : Map
  + close()
}
interface AutoCloseable
AutoCloseable <|.. OnlineCollectionService
interface ProductCollector {
  + collect(selected, progress) : List<Result>
}
class OnlineCatalog {
  - sources : List<Source>
  + collect(selected, progress) : List<Result>
}
class CollectionListService {
  + list() : List<CollectionSource>
  + add(verified) : Map
  + change(key, action) : Map
}
Service <|-- CollectionListService
Service <|-- OnlineCollectionService
OnlineCollectionService "1" --> "1" ProductCollector : collector
OnlineCollectionService "1" --> "0..1" TargetService : targets
ProductCollector <|.. OnlineCatalog
Service <|-- LedgerService
Service <|-- BudgetService
Service <|-- PriceService
Service <|-- ProductService
Service <|-- TargetService
ProductService "1" --> "1" MartAdapter : adapter
ProductService "1" --> "0..1" TargetService : targets
legend bottom
  Parameter lists and private helpers omitted.
  + public    - private    ~ package access
  Hollow triangle: inheritance / interface implementation.
  Constructors and HTTP/parser helpers omitted. No dependency arrows.
endlegend
@enduml
