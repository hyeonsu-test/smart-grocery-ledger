@startuml
skinparam dpi 180
skinparam defaultFontName Arial
skinparam defaultFontSize 18
skinparam shadowing false
skinparam ParticipantPadding 4
hide footbox
participant UI
participant "Collection\nservice" as Service
participant Catalog as Collector
participant Site
participant Repo
participant Target
UI -> Service : 1. collect()
Service -> Repo : 2. snapshot selected sources
Service -> Collector : 3. collect(enabled sources)
loop Each enabled source
Collector -> Site : 4. HTTPS GET
Site --> Collector : page / error
Collector -> Collector : validate
end
Collector --> Service : 5. results
Service -> Repo : 6. recheck settings / merge
Service -> Repo : 7. saveAtomic()
Repo --> Service : OK / SAVE_FAILED
alt Saved
Service -> Target : 8. EVALUATE
end
Service --> UI : 9. results
@enduml

